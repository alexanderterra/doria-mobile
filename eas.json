{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "homolog": {
      "channel": "homolog",
      "ios": {
        "distribution": "store"
      },
      "android": {
        "distribution": "store"
      }
    },
    "production": {
      "channel": "production",
      "cache": {
        "disabled": true
      }
    }
  },
  "submit": {
    "homolog": {}
  }
}
